# geivs-gateway — consolidated env (copy per-service files into ~/geivs-secrets/)
# Signal
JEEVES_OWNERS=+10000000000          # comma-separated allow-list (your Signal number; add client numbers here)
SIGNAL_API_MODE=daemon              # "daemon" (Richard's dev box, signal-cli daemon) or "rest" (product/container, bbernhard/signal-cli-rest-api)
# daemon mode:
SIGNAL_RPC=http://127.0.0.1:8080/api/v1/rpc
SIGNAL_EVENTS=http://127.0.0.1:8080/api/v1/events
# rest mode:
SIGNAL_REST_URL=http://signal-cli:8080
SIGNAL_ACCOUNT=+10000000000         # the bot's own registered Signal number (required for rest mode)
SIGNAL_REST_POLL_INTERVAL=2
# n8n
JEEVES_WEBHOOK=http://127.0.0.1:5001/webhook/jeeves
# ports
JEEVES_SEND_PORT=8765
