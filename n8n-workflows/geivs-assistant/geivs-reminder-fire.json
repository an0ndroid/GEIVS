{
  "id": "geivsremfire1",
  "name": "GEIVS - Reminder Fire",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "resource": "table",
        "operation": "create",
        "tableName": "geivs_reminders",
        "columns": {
          "column": [
            {
              "name": "reminder_id",
              "type": "string"
            },
            {
              "name": "due",
              "type": "string"
            },
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "done",
              "type": "boolean"
            }
          ]
        },
        "options": {
          "createIfNotExists": true
        }
      },
      "id": "c2222222-2222-4222-8222-222222222222",
      "name": "Ensure Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "geivs_reminders"
        },
        "returnAll": true,
        "filters": {
          "conditions": []
        },
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Get Reminders",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = Date.now();\nconst out = [];\nfor (const it of rows) {\n  const r = it.json || {};\n  if (r.done === true) continue;\n  if (!r.due) continue;\n  const t = new Date(r.due).getTime();\n  if (!isNaN(t) && t <= now) {\n    out.push({ json: { reminder_id: r.reminder_id, text: r.text, due: r.due } });\n  }\n}\nreturn out;"
      },
      "id": "c4444444-4444-4444-8444-444444444444",
      "name": "Filter Due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "geivs_reminders"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "reminder_id",
              "condition": "eq",
              "keyValue": "={{ $json.reminder_id }}"
            }
          ]
        },
        "matchType": "anyCondition",
        "options": {}
      },
      "id": "c5555555-5555-4555-8555-555555555555",
      "name": "Mark Done (delete)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:8765/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'Reminder: ' + $json.text }) }}",
        "options": {}
      },
      "id": "c6666666-6666-4666-8666-666666666666",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Ensure Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ensure Table": {
      "main": [
        [
          {
            "node": "Get Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Reminders": {
      "main": [
        [
          {
            "node": "Filter Due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Due": {
      "main": [
        [
          {
            "node": "Mark Done (delete)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Done (delete)": {
      "main": [
        [
          {
            "node": "Send Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}