{
  "id": "geivsbrief1",
  "name": "GEIVS - Morning Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "b1111111-1111-4111-8111-111111111111",
      "name": "Schedule 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "geivs-brief-test",
        "responseMode": "onReceived",
        "options": {}
      },
