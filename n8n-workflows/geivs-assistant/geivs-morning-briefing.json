      "typeVersion": 2,
      "position": [
        0,
        420
      ],
      "webhookId": "7f3a1c22-9b44-4d88-a1e2-5c6d7e8f9012"
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/calendar/v3/calendars/{{OWNER_CALENDAR_EMAIL_URLENC}}/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "singleEvents",
              "value": "true"
            },
            {
              "name": "orderBy",
              "value": "startTime"
            },
            {
              "name": "timeMin",
              "value": "={{ $now.startOf('day').toISO() }}"
            },
            {
              "name": "timeMax",
              "value": "={{ $now.plus({ days: 1 }).startOf('day').toISO() }}"
            },
            {
              "name": "maxResults",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "id": "b3333333-3333-4333-8333-333333333333",
      "name": "Calendar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": {
        "googleApi": {
          "id": "dRaetinoQyffjWEJ",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "simple": true,
        "filters": {
          "readStatus": "unread"
        }
      },
      "id": "b4444444-4444-4444-8444-444444444444",
      "name": "Gmail Unread",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        300
      ],
      "alwaysOutputData": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "IulSQ6PPXKxOzPfN",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const calJson = $('Calendar').first().json || {};\nconst calOk = Array.isArray(calJson.items);\nconst events = calOk ? calJson.items : [];\n\nconst emails = $('Gmail Unread').all()\n  .map(i => i.json)\n  .filter(e => e && (e.id || e.Subject || e.subject));\n\nfunction evTime(ev) {\n  const st = ev.start || {};\n  if (st.date && !st.dateTime) return 'all day';\n  const s = st.dateTime || st.date;\n  if (!s) return 'all day';\n  const d = new Date(s);\n  return d.toISOString().substring(11, 16) + 'Z';\n}\n\nconst now = new Date();\nconst dateStr = now.toUTCString().slice(0, 16); // e.g. \"Fri, 03 Jul 2026\"\n\nconst lines = [];\nlines.push('Morning briefing for ' + dateStr + '.');\nlines.push('');\nlines.push(\"Today's calendar:\");\nif (!calOk) {\n  lines.push('- Calendar unavailable right now.');\n} else if (events.length === 0) {\n  lines.push('- Nothing scheduled today.');\n} else {\n  for (const ev of events) {\n    lines.push('- ' + evTime(ev) + ' ' + (ev.summary || '(no title)'));\n  }\n}\nlines.push('');\nlines.push('Unread email (' + emails.length + '):');\nif (emails.length === 0) {\n  lines.push('- Inbox clear, nothing unread.');\n} else {\n  for (const e of emails) {\n    const subj = e.Subject || e.subject || '(no subject)';\n    const from = e.From || e.from || '';\n    lines.push('- ' + subj + (from ? ' - ' + from : ''));\n  }\n}\n\nconst briefing_plain = lines.join('\\n');\nreturn [{ json: { briefing_plain, event_count: events.length, unread_count: emails.length } }];"
      },
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "Assemble",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-oss:20b\", system: \"Reasoning: low\\nYou are GEIVS, Richard's warm British butler. Rewrite the briefing below into a short, friendly good-morning message for Richard, delivered over Signal. Plain text ONLY: no markdown, no asterisks, no bullet characters, no headings, no code fences. Keep it to a few short sentences. Preserve every concrete fact: event times and titles, unread email senders and subjects, and the counts. If there is nothing scheduled or no unread mail, say so briefly and cheerfully.\", prompt: $json.briefing_plain, stream: false }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "b6666666-6666-4666-8666-666666666666",
      "name": "LLM Polish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "let polished = null;\ntry {\n  const r = $json.response;\n  if (typeof r === 'string' && r.trim().length > 0) polished = r.trim();\n} catch (e) {}\nconst fallback = $('Assemble').first().json.briefing_plain;\nconst message = (polished || fallback || 'Good morning Richard.').toString();\nreturn [{ json: { message } }];"
      },
      "id": "b7777777-7777-4777-8777-777777777777",
      "name": "Prepare Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:8765/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.message }) }}",
        "options": {}
      },
      "id": "b8888888-8888-4888-8888-888888888888",
      "name": "Send to Signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ]
    }
  ],
