# =============================================================
# GEIVS Pro — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# --- Security Keys (generate with: openssl rand -hex 32) ---
WEBUI_SECRET_KEY=changeme_generate_a_real_secret
N8N_ENCRYPTION_KEY=changeme_generate_a_real_key
JWT_SECRET=changeme_generate_a_real_secret

# --- Database ---
DB_PASSWORD=changeme_strong_password

# --- Network ---
N8N_HOST=localhost

# --- Open WebUI Admin Account (created on first boot) ---
ADMIN_EMAIL=admin@geivs.local
ADMIN_PASSWORD=changeme_strong_password
ADMIN_NAME=Admin

# --- Open WebUI API Key (generate in Open WebUI settings after first login) ---
OPENWEBUI_API_KEY=

# --- Optional: Signal phone number (set during onboarding) ---
# SIGNAL_PHONE_NUMBER=+1xxxxxxxxxx
